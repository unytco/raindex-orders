# ===========================================
# Holo Bridge Sepolia deployment (deploy-sepolia.sh)
# ===========================================
# Copy this file to .env. It holds addresses, never a private key:
# deploy-sepolia.sh signs with --account <keystore> or --ledger.
# NEVER commit .env to git!

SEPOLIA_RPC_URL=https://1rpc.io/sepolia

# forge test forks Ethereum mainnet through this RPC (test/TestClaim.t.sol)
RPC_URL_ETH=https://1rpc.io/eth

# ===========================================
# Written by deploy-sepolia.sh
# ===========================================

# MockHOT token address (step 1)
TOKEN_ADDRESS=

# HoloLockVault address (step 2)
SEPOLIA_LOCK_VAULT_ADDRESS=

# Claim order hash and owner (step 4). The owner is the vault.
ORDER_HASH=
ORDER_OWNER=

# ===========================================
# Existing Sepolia Infrastructure
# ===========================================
