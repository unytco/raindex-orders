# ===========================================
# The Holo Bridge TestNet deployed on Base Sepolia (README.md, TestNet on Base Sepolia)
# ===========================================
# .env.example with this deploy's addresses filled in. Copy it to .env to work
# with the deployed TestNet: `deploy-base-sepolia.sh status`, a mint, a signer
# rotation, or the orchestrator against it. For a new deploy, copy .env.example.
# It holds addresses, never a private key: deploy-base-sepolia.sh signs with
# --account <keystore> or --ledger. NEVER commit .env to git!

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# forge test forks Ethereum mainnet through this RPC (test/TestClaim.t.sol),
# and Base Sepolia through RPC_URL_BASE_SEPOLIA
RPC_URL_ETH=https://ethereum-rpc.publicnode.com
RPC_URL_BASE_SEPOLIA=https://base-sepolia-rpc.publicnode.com

# ===========================================
# Written by deploy-base-sepolia.sh
# ===========================================

# MockHOT token address (step 1)
TOKEN_ADDRESS=0x48c47491e4B424896a9FB9F23ff8119B67DADff4

# HoloLockVault and its ClaimInputToken (step 2)
BASE_SEPOLIA_LOCK_VAULT_ADDRESS=0xEdDdBEF1b6dEb820888661829ecF70e9621328B4
CLAIM_INPUT_TOKEN=0xcd93874448155B54FbA986bd0081836956623278

# Claim order hash and owner (step 4). The owner is the vault.
ORDER_HASH=0x98a13365e5b43eebe38053830636bb132cddd0b14cef82c9c6c8d79cf823623e
ORDER_OWNER=0xEdDdBEF1b6dEb820888661829ecF70e9621328B4

# The claim order's bytecode, as its AddOrderV3 event carries it. The orchestrator
# needs it (bridge-orchestrator/README.md); deploy-base-sepolia.sh does not.
CLAIM_

# ===========================================
# Rain's contracts, the same on Base Sepolia and Ethereum mainnet
# ===========================================
ORDERBOOK_ADDRESS=0x37FC0EFec37D19f8A221aa4F8F7600C9ba2AcD20
VAULT_ID=0xeede83a4244afae4fef82c8f5b97df1f18bfe3193e65ba02052e37f6171b334b
