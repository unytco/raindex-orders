# The website for the TestNet deployed on Base Sepolia (README.md, TestNet on
# Base Sepolia). Copy this file to ui/.env.local for `npm run dev`, or set these
# on the Cloudflare Worker hot-bridge-ui-testnet. NEVER commit .env.local to git!

# The build takes the deploy's addresses, order hash and bytecode from
# BASE_SEPOLIA_DEFAULTS in ui/src/lib/network.ts, so no PUBLIC_* address is set
# here. Set one only to build for another deploy, and then all of them
# (ui/.env.example).
PUBLIC_NETWORK=base-sepolia

# Runtime secrets: the RPC, and the faucet wallet's key, 0x-prefixed. The faucet
# sends 1000 mock HOT a request from that wallet, so fund it with mock HOT and
# Base Sepolia ETH for gas. On Cloudflare, set the key as a Worker secret by hand.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
FAUCET_PRIVATE_KEY=

# true pauses Lock and the faucet. A Worker secret set by hand, never a build
# variable (README.md, Pausing the bridge).
BRIDGE_PAUSED=
